# Copy to deploy/video/.env or enter the same values in Coolify.
# Never commit the real file.

VIDEO_PLATFORM_IMAGE_TAG=local
COOLIFY_PROXY_NETWORK=coolify
EVOLUTION_DOCKER_NETWORK=replace-with-existing-evolution-network
TRAEFIK_CERT_RESOLVER=letsencrypt

DATABASE_URL=postgresql://service_user:replace-me@db.example.invalid:5432/postgres
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=8
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# PEM with literal \n, or base64 of the complete PUBLIC KEY PEM.
UPLOAD_TOKEN_PUBLIC_KEY=replace-with-ed25519-public-key
UPLOAD_TOKEN_KEY_ID=mizan-upload-2026-01
UPLOAD_TOKEN_ISSUER=mizan-web
UPLOAD_TOKEN_AUDIENCE=mizan-video-upload
UPLOAD_TOKEN_MAX_TTL_SECONDS=600
UPLOAD_TOKEN_CLOCK_TOLERANCE_SECONDS=20
UPLOAD_MAX_BYTES=2147483648
UPLOAD_MAX_SECONDS=600

# Generate independent, random secrets; minimum 32 bytes each.
HOOK_SHARED_SECRET=replace-with-random-32-byte-secret
MEDIA_SIGNING_SECRET=replace-with-random-32-byte-secret
INTERNAL_API_SHARED_SECRET=replace-with-random-32-byte-secret
PUBLIC_LINK_TOKEN_SECRET=replace-with-random-32-byte-secret

# Base64 of exactly 32 random bytes. This key must stay on the VDS.
ACCESS_CODE_ENCRYPTION_KEY=replace-with-base64-32-byte-key

VIDEO_PUBLIC_BASE_URL=https://video.softartdevstudios.cloud
CORS_ALLOWED_ORIGINS=https://mizander.com.tr,https://www.mizander.com.tr
# tusd browser origins are pinned in compose.yaml so Coolify cannot
# double-escape the regular expression.
TRUST_PROXY=true
MEDIA_TOKEN_TTL_SECONDS=300
MEDIA_DELIVERY_MODE=node
MEDIA_X_ACCEL_PREFIX=/_protected-video
ACCESS_CODE_MAX_ATTEMPTS=5
ACCESS_CODE_WINDOW_SECONDS=900
ACCESS_CODE_BLOCK_SECONDS=900
INTERNAL_SIGNATURE_MAX_AGE_SECONDS=300

EVOLUTION_INTERNAL_URL=http://evolution-api:8080
EVOLUTION_API_KEY=replace-with-evolution-api-key
EVOLUTION_INSTANCE_NAME=mizan-delivery
EVOLUTION_HEALTH_PATH=/instance/connectionState/{instance}
# Optional and version-specific. Keep unset until verified against the installed Evolution version.
# EVOLUTION_LOOKUP_PATH=/chat/findStatusMessage/{instance}?messageId={messageId}
EVOLUTION_TIMEOUT_MS=20000
EVOLUTION_HEALTH_INTERVAL_MS=30000
EVOLUTION_OUTAGE_ERROR_LIMIT=5

# Phone values stay only in the VDS secret environment. API returns key+label, never phone.
DELIVERY_SAFE_TEST_NUMBERS_JSON=[{"key":"admin-primary","label":"Yönetici test hattı","phone":"905000000000"}]
REQUIRE_DELIVERY_TEST=false
MESSAGE_MIN_DELAY_MS=5000
MESSAGE_MAX_DELAY_MS=9000
MESSAGE_BATCH_SIZE=50
MESSAGE_BATCH_PAUSE_MS=120000
MESSAGE_WORKER_POLL_MS=2000
MESSAGE_LEASE_MINUTES=5

FFMPEG_THREADS=2
VIDEO_TRANSCODE_ENABLED=false
FFMPEG_TIMEOUT_MS=2700000
OUTPUT_MAX_RAW_RATIO=1.10
VIDEO_RETRY_DELAY_SECONDS=30
CLOSING_TITLE=Mizan İnsani Yardım Derneği
CLOSING_MESSAGE=Allah hayrınızı kabul etsin.
CLOSING_CREDIT=Powered by SoftArt Studios

RETENTION_INTERVAL_MS=3600000
DISK_WARNING_BYTES=21474836480
DISK_BLOCK_BYTES=16106127360
FFMPEG_RESERVE_BYTES=1073741824
